# Discord bot token
API_KEY=your-discord-bot-token

# Channel ID where alerts are posted (required for DNS and HTTP monitoring)
DNS_ALERT_CHANNEL_ID=123456789012345678

# DNS monitoring: the same DNS server is queried for both domains (A record)
DNS_SERVER=1.1.1.1
DNS_CHECK_EXTERNAL_HOST=example.com
DNS_CHECK_INTERNAL_HOST=internal.example.local

# HTTP monitoring: comma-separated URLs; status 200-204 is healthy.
# Leave empty to disable.
HTTP_CHECK_URLS=https://a.example.com/health,https://b.example.com/,http://internal.example.local/status
